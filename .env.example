DATABASE_URL=postgres://...
# TLS to the database is verified by default. Set DATABASE_SSL_CA to a provider CA
# if Node does not carry it; DATABASE_SSL_NO_VERIFY=true turns verification off and
# should only ever be a deliberate, temporary exception.
DATABASE_SSL_CA=
DATABASE_SSL_NO_VERIFY=
JWT_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com
SEED_OWNER_USERNAME=
SEED_OWNER_PASSWORD=
APP_TIMEZONE=Asia/Beirut
DISCONNECT_THRESHOLD_USD_CENTS=5000
OWNER_CONTACT_PHONE=
OWNER_CONTACT_NAME=
