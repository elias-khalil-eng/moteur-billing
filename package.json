{
  "name": "moteur",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm --prefix client run build",
    "dev": "npm --prefix client run dev",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "backup": "tsx scripts/backup.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "lint": "oxlint lib netlify scripts client/src && tsc -p tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "restore": "tsx scripts/restore.ts",
    "serve": "tsx scripts/serve.ts",
    "dev:api": "tsx scripts/serve.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@netlify/functions": "^3.0.0",
    "@playwright/test": "^1.49.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/web-push": "^3.6.4",
    "oxlint": "^0.15.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
